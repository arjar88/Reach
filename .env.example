APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL_POOLED=postgres://reach:reach@127.0.0.1:5432/reach
DATABASE_URL_SESSION=postgres://reach:reach@127.0.0.1:5432/reach
REDIS_URL=redis://127.0.0.1:6379
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=
APIFY_TOKEN=
# LLM calls go through the Vercel AI SDK. Set one key.
# LLM_PROVIDER=google uses GEMINI_API_KEY (or GOOGLE_GENERATIVE_AI_API_KEY).
# LLM_PROVIDER=anthropic uses ANTHROPIC_API_KEY.
# LLM_PROVIDER=gateway uses AI_GATEWAY_API_KEY and provider/model ids.
# When LLM_PROVIDER is empty, the first key that is set wins: Gemini, then the gateway, then Anthropic.
LLM_PROVIDER=
GEMINI_API_KEY=
LLM_MODEL_SMALL=
LLM_MODEL_STRONG=
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMALL=claude-haiku-4-5
CLAUDE_MODEL_STRONG=claude-sonnet-4-5
PROSPEO_API_KEY=
LEADMAGIC_API_KEY=
ICYPEAS_API_KEY=
MILLIONVERIFIER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SIGNING_SECRET=
SENTRY_DSN=
OPS_ALERT_EMAIL=
OPS_SLACK_WEBHOOK=
CRON_SECRET=
