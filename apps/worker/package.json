{
  "name": "@reach/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:bullmq --external:ioredis --external:postgres --external:drizzle-orm --external:luxon --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reach/shared": "workspace:*",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.44.6",
    "ioredis": "^5.8.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
